{
  "name": "suraj-jha-portfolio",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run knowledge && npm run typecheck:api && ng build && node scripts/postbuild.mjs",
    "knowledge": "node scripts/build-knowledge.mjs",
    "typecheck:api": "tsc -p api/tsconfig.json --noEmit",
    "test:chat": "npm run knowledge && tsc -p api/tsconfig.json --outDir out-tsc/api && node --test scripts/chat.test.cjs",
    "watch": "ng build --watch --configuration development",
    "prerender": "echo Prerendering now runs as part of npm run build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-server": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@angular/ssr": "^17.3.17",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "gsap": "^3.15.0",
    "motion": "^14.0.0",
    "nodemailer": "^6.9.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.14.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^18.18.0",
    "@types/nodemailer": "^6.4.0",
    "@vercel/node": "^3.2.0",
    "pdfjs-dist": "^5.4.624",
    "typescript": "~5.4.0"
  }
}
