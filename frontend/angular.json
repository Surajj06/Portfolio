{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "suraj-jha-portfolio": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": { "style": "scss", "standalone": true, "changeDetection": "OnPush" }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/suraj-jha-portfolio",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              { "glob": "**/*", "input": "src/assets", "output": "assets" },
              { "glob": "{robots.txt,sitemap.xml,site.webmanifest}", "input": "src", "output": "/" }
            ],
            "styles": [
              "node_modules/@fontsource-variable/bricolage-grotesque/wght.css",
              "node_modules/@fontsource/instrument-serif/latin-400-italic.css",
              "src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "server": "src/main.server.ts",
              "prerender": { "routesFile": "routes.txt" },
              "outputHashing": "all",
              "budgets": [
                { "type": "initial", "maximumWarning": "520kb", "maximumError": "800kb" },
                { "type": "anyComponentStyle", "maximumWarning": "14kb", "maximumError": "28kb" }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                { "replace": "src/environments/environment.ts", "with": "src/environments/environment.development.ts" }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": { "port": 4201 },
          "configurations": {
            "production": { "buildTarget": "suraj-jha-portfolio:build:production" },
            "development": { "buildTarget": "suraj-jha-portfolio:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "ec06c17c-ed39-4c39-bc43-3aaad1dc1cff"
  }
}
