{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "suraj-jha-portfolio": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": { "style": "scss", "standalone": true }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/suraj-jha-portfolio/browser",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": ["src/favicon.ico", "src/assets", "src/robots.txt", "src/sitemap.xml"],
            "styles": ["src/styles.scss"],
            "scripts": [],
            "budgets": [
              { "type": "initial", "maximumWarning": "600kb", "maximumError": "1mb" },
              { "type": "anyComponentStyle", "maximumWarning": "16kb", "maximumError": "32kb" }
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "750kb", "maximumError": "1mb" }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                { "replace": "src/environments/environment.ts", "with": "src/environments/environment.development.ts" }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 4201
          },
          "configurations": {
            "production": { "buildTarget": "suraj-jha-portfolio:build:production" },
            "development": { "buildTarget": "suraj-jha-portfolio:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "server": {
          "builder": "@angular-devkit/build-angular:server",
          "options": {
            "outputPath": "dist/suraj-jha-portfolio/server",
            "main": "server.ts",
            "tsConfig": "tsconfig.server.json"
          },
          "configurations": {
            "production": {
              "outputHashing": "media"
            },
            "development": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ],
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-ssr": {
          "builder": "@angular-devkit/build-angular:ssr-dev-server",
          "configurations": {
            "development": {
              "browserTarget": "suraj-jha-portfolio:build:development",
              "serverTarget": "suraj-jha-portfolio:server:development"
            },
            "production": {
              "browserTarget": "suraj-jha-portfolio:build:production",
              "serverTarget": "suraj-jha-portfolio:server:production"
            }
          },
          "defaultConfiguration": "development"
        },
        "prerender": {
          "builder": "@angular-devkit/build-angular:prerender",
          "options": {
            "routes": [
              "/",
              "/projects/ai-voice-calling-platform",
              "/projects/vehicle-catalogue-matching-engine",
              "/projects/conversational-quote-assistant",
              "/projects/whatsapp-document-verification-bot",
              "/projects/agent-gamification-platform",
              "/projects/stock-intelligence-engine",
              "/projects/api-health-monitor"
            ]
          },
          "configurations": {
            "production": {
              "browserTarget": "suraj-jha-portfolio:build:production",
              "serverTarget": "suraj-jha-portfolio:server:production"
            },
            "development": {
              "browserTarget": "suraj-jha-portfolio:build:development",
              "serverTarget": "suraj-jha-portfolio:server:development"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  },
  "cli": {
    "analytics": "ec06c17c-ed39-4c39-bc43-3aaad1dc1cff"
  }
}
